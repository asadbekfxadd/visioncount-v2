# ==== Общие ====
COMPOSE_PROJECT_NAME=visioncount

# ==== PostgreSQL ====
POSTGRES_USER=visioncount
POSTGRES_PASSWORD=change_me
POSTGRES_DB=visioncount
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://visioncount:change_me@postgres:5432/visioncount

# ==== Redis ====
REDIS_URL=redis://redis:6379/0

# ==== Backend ====
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CAMERA_CREDENTIALS_ENCRYPTION_KEY=change_this_fernet_key_44_chars_base64==
BACKEND_CORS_ORIGINS=http://localhost:3000
DEMO_MODE=true
RATE_LIMIT_PER_MINUTE=120

# ==== AI service ====
AI_SERVICE_URL=http://ai-service:8100
YOLO_MODEL=yolov8n.pt
YOLO_DEVICE=cpu

# ==== Frontend ====
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ==== Безопасность (обязательно в production) ====
# SECRET_KEY — подпись JWT, не короче 32 символов; FERNET_KEY — шифрование паролей камер
# SERVICE_KEY — ключ ai-service для /internal/* (если пусто — используется SECRET_KEY)
# APP_ENV=production — запрещает старт с ключами по умолчанию и отключает демо-пользователя
